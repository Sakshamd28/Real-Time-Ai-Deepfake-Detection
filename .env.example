# Get a free API key at https://build.nvidia.com (click "Get API Key" on any model page)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: NVIDIA Vision model (defaults to meta/llama-3.2-11b-vision-instruct)
# Supported options: meta/llama-3.2-11b-vision-instruct, meta/llama-3.2-90b-vision-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional port (defaults to 3000)
PORT=3000
